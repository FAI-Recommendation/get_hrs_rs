# ─────────────────────────────────────────────
# Data paths
# ─────────────────────────────────────────────
DATA_DIR=./get10k_data
OUTPUT_DIR=./rs/lightgcn_pyg/output
WEIGHTS_DIR=./rs/lightgcn_pyg/weights

# ─────────────────────────────────────────────
# GPU
# ─────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
GPU_ID=0

# ─────────────────────────────────────────────
# Training defaults (co the override bang --arg khi chay train.py)
# ─────────────────────────────────────────────
SIM_TYPE=img_only        # none | img_only | multimodal | tfidf | bert | full_bert
EMBED_SIZE=64
BATCH_SIZE=1024
LR=0.001
EPOCH=1000
EVAL_INTERVAL=10
EARLY_STOP_STEPS=5

# ─────────────────────────────────────────────
# Wandb (optional — de trong neu khong dung)
# Bat: them --use_wandb 1 khi chay train.py
# Setup: wandb login  (hoac dat WANDB_API_KEY o day)
# ─────────────────────────────────────────────
WANDB_API_KEY=
WANDB_ENTITY=              # ten team/org tren wandb (bo trong neu dung personal account)
WANDB_PROJECT=combigcn-rs
WANDB_MODE=online          # online | offline | disabled

# ─────────────────────────────────────────────
# HuggingFace Hub (optional — de trong neu khong dung)
# Bat: them --use_hf 1 --hf_repo_id YourOrg/combigcn-fashion-rs khi chay train.py
# Token can quyen Write: huggingface.co/settings/tokens
# ─────────────────────────────────────────────
HF_TOKEN=
HF_REPO_ID=               # vd: HoangVuSnape/combigcn-fashion-rs
